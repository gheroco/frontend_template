{
  "name": "@atlas/extension-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/contracts": "1.0.0",
    "@atlas/service-kit": "1.0.0",
    "@kubernetes/client-node": "2.0.0",
    "chokidar": "5.0.0",
    "fastify": "5.12.3",
    "prom-client": "15.1.3",
    "yaml": "2.9.0"
  }
}
