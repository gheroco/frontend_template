{
  "name": "@atlas/portal-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/index.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/server/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/contracts": "1.0.0",
    "@atlas/service-kit": "1.0.0",
    "@fastify/secure-session": "8.3.0",
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  }
}
