{
  "name": "@atlas/audit-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/index.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.mfe.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/contracts": "1.0.0",
    "@atlas/service-kit": "1.0.0",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1"
  }
}
