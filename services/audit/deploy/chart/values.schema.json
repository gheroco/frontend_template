{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "portalRegistration", "secret"],
  "properties": {
    "image": { "type": "object", "required": ["repository", "tag"], "properties": { "repository": { "type": "string", "minLength": 3 }, "tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$", "not": { "const": "latest" } }, "digest": { "type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$" } } },
    "portalRegistration": { "type": "object", "required": ["serviceVersion", "extensionVersion", "integrity"], "properties": { "serviceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$" }, "extensionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+].*)?$" }, "integrity": { "type": "string", "pattern": "^sha384-[A-Za-z0-9+/]{64}$" } } },
    "secret": { "type": "object", "required": ["existingName"], "properties": { "existingName": { "type": "string", "minLength": 1 } } }
  }
}
