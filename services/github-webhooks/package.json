{
  "name": "@atlas/github-webhooks-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server/index.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.mfe.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/server/index.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/server/worker.js",
    "migrate": "node --env-file-if-exists=../../.env dist/server/migrate.js",
    "reconcile": "node --env-file-if-exists=../../.env dist/server/reconciler.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@atlas/contracts": "1.0.0",
    "@atlas/service-kit": "1.0.0",
    "@fastify/static": "10.1.3",
    "amqplib": "2.0.1",
    "fastify": "5.11.3",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/pg": "8.21.0"
  }
}
